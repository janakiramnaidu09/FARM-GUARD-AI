# ==============================================================================
# FarmGuard AI - Backend API Environment Configuration
# ==============================================================================

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/farmguard?sslmode=disable
DATABASE_PROVIDER=postgres

# Auth and Session
AUTH_SESSION_SECRET=farmguard-development-session-secret-change-in-production-32chars
AUTH_COOKIE_NAME=farmguard_session

# Google Gemini AI (Server-Side Advisory & Voice Assistant)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Weather Service (Open-Meteo works without API key)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=900

# File Storage for Crop Disease Photos
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=farmguard-private-images
LOCAL_PRIVATE_UPLOAD_DIR=./private-uploads

# ML Computer Vision Microservice (FastAPI)
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=dev-ml-token-change-in-production
MODEL_PATH=
MODEL_MANIFEST_PATH=model/model_manifest.json
DISEASE_CONFIDENCE_THRESHOLD=0.75
MAX_IMAGE_BYTES=8388608

# Operational Settings
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=15000
