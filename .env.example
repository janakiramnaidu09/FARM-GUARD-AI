NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# Supabase PostgreSQL Database Configuration
# ==============================================================================
# 1. Direct Connection String (Port 5432):
#    postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# 2. Connection Pooler - Session Mode (Port 5432, recommended for IPv4):
#    postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# 3. Connection Pooler - Transaction Mode (Port 6543):
#    postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
DATABASE_PROVIDER=supabase

# Required for signing sessions or tokens; generate a strong random secret.
AUTH_SESSION_SECRET=farmguard-development-session-secret-change-in-production-32chars
AUTH_COOKIE_NAME=farmguard_session

# Gemini is server-side only. Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Weather provider configuration (Open-Meteo works without an API key).
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_CACHE_TTL_SECONDS=900

# Optional private Supabase Storage integration for disease images.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=farmguard-private-images

# Disease inference service (Python FastAPI service).
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_TOKEN=dev-ml-token-change-in-production
MODEL_PATH=
MODEL_MANIFEST_PATH=model/model_manifest.json
DISEASE_CONFIDENCE_THRESHOLD=0.75
MAX_IMAGE_BYTES=8388608

# Local private storage adapter for development.
LOCAL_PRIVATE_UPLOAD_DIR=./private-uploads

# Operational settings
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=15000
